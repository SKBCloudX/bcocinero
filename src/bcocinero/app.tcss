Hostname, Nameserver {
  height: auto;
}
Button {
  border: none;
  min-width: 0;
  margin: 0 1;
  padding: 0 1;
}
StatusBar {
  dock: bottom;
  height: 1;
  background: $accent;
  color: $text;
}
#confirm_dialog {
    grid-size: 2;
    grid-gutter: 1;
    grid-rows: 1fr 3;
    padding: 1 2;
    width: 40;
    height: 11;
    border: thick $primary;
    background: $surface;
    align: center middle;
}
#confirm {
    column-span: 2;
    height: 1fr;
    content-align: center middle;
}
#vlan_list_widget, #bond_list_widget { 
  height: 1fr;
  border: round $accent;
  margin: 0 0;
}
Horizontal {
  height: auto;
  align: left middle;
}
.dashboard_hostname {
  height: 1fr;
}
.dashboard_interface {
  height: 4fr;
  overflow-y: auto;
}
.dashboard_installer {
  height: 1fr;
}
Input {
  width: auto;
  height: auto;
}
Label {
  padding: 0 0;
}
#edit_lock_label {
  color: red;
  padding: 1 1;
  text_style: bold italic;
}
.label-fixed {
  width: 18;                  
  content-align: left middle;
  padding-right: 2;         
  color: $text-muted;      
}
#mode_list {
  layout: grid;
  grid-size: 3;
  grid-columns: 1fr 1fr 1fr;
  height: auto;
}
#port_container {
  layout: grid;
  grid-size: 4;
  grid-columns: 1fr 1fr 1fr 1fr;
  height: auto;
}
#port_container Checkbox {
  width: auto;
}
RadioButton {
  width: 100%;
  height: auto;
  margin-right: 1;
}
#list_interface_table {
  height: 15;
  min-height: 10;
}
#hc_ip_container {
  display: none;
}
#hc_ip_container.show {
  display: block;
}
#main_log {
  dock: bottom;
  height: 5;
  background: $surface;
  border-top: tall $accent;
  color: $text;
}
#host_list_widget {
  height: 2fr;
  border: round $accent;
  margin: 0 0;
}
#installer_block {
  height: 1fr;
  border: round $accent;
  margin: 0 0;
}
#result_block {
  height: 2fr;
  border: round $accent;
  margin: 0 0;
}
