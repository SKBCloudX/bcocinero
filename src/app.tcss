Button {
  border: none;
  min-width: 0;
  margin: 0 1;
}
#confirm_dialog {
    grid-size: 2;
    grid-gutter: 1;
    grid-rows: 1fr 3;
    padding: 1 2;
    width: 40;
    height: 11;
    border: thick $primary;
    background: $surface;
    align: center middle;
}
#confirm {
    column-span: 2;
    height: 1fr;
    content-align: center middle;
}
#vlan_list_widget, #bond_list_widget {
  height: 1fr;
  border: round $accent;
  margin: 0 0;
}
Horizontal {
  height: auto;
  align: left middle;
}
